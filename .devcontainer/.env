# Active configuration for THIS machine. Not committed (see .gitignore).
COMPOSE_PROJECT_NAME=partena
ODOO_VERSION=20.0
PYTHON_BASE=python:3.12-bookworm

# Match the container user to your host user so rw mounts stay your-owned.
USER_UID=1000
USER_GID=1000

# The partena workspace (this repo). Relative to .devcontainer/ where compose runs.
WORKSPACE=..

# Host paths to the shared, already-cloned Odoo source repositories.
ODOO_SRC=/home/dbo/Projects/worktrees/master/odoo
ENTERPRISE_SRC=/home/dbo/Projects/worktrees/master/enterprise
DESIGN_THEMES_SRC=/home/dbo/Projects/worktrees/master/design-themes

# Custom addons, one repo per instance:
#   partena_custom (central)  -> psbe-partena-20
PARTENA_CUSTOM_SRC=/home/dbo/Projects/psbe-partena-20

# Database
DB_USER=odoo
DB_PASSWORD=odoo

# Host port mappings (http == internal http_port for each instance).
CLIENT_HTTP_PORT=8089
CLIENT_GEVENT_PORT=8090
CUSTOM_HTTP_PORT=8099
CUSTOM_GEVENT_PORT=8100
DB_PORT=5044
